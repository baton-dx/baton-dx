{
  "name": "@baton-dx/cli",
  "version": "0.14.2",
  "description": "CLI for Baton - the package manager for Developer Experience & AI configuration",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "baton": "./dist/index.mjs",
    "baton-dx": "./dist/index.mjs",
    "btx": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md ."
  },
  "dependencies": {},
  "devDependencies": {
    "@baton-dx/ai-tool-paths": "workspace:*",
    "@baton-dx/core": "workspace:*",
    "@clack/core": "^1.0.1",
    "@clack/prompts": "^1.0.1",
    "citty": "^0.1.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1",
    "simple-git": "^3.30.0",
    "yaml": "^2.8.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baton-dx/baton.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/baton-dx/baton#readme",
  "bugs": {
    "url": "https://github.com/baton-dx/baton/issues"
  },
  "license": "MIT"
}
