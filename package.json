{
  "name": "baton-dx-monorepo",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "dead-code": "knip",
    "dev": "tsx packages/cli/src/index.ts",
    "changeset": "changeset",
    "ci:version": "changeset version && bun update",
    "ci:publish": "bun run build && bun run test && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "knip": "^5.83.1",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
